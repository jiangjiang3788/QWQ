{
  "version": "3.0.0-V1",
  "principle": "single-source-dynamic-tables",
  "sourceOfTruth": "character.memoryStore",
  "runtime": "js/features/memory/simple_memory_v1.js",
  "domains": {
    "store": ["settings", "tables", "records"],
    "levels": ["short", "medium", "long"],
    "writePaths": {
      "short": "chat-direct",
      "medium": "configured-aggregation-direct",
      "long": "manual-only"
    },
    "recordMetadata": ["category", "tags", "source", "createdAt", "updatedAt"],
    "sourceValues": ["用户明确", "AI判断"],
    "contextSelection": ["category-match", "tag-match", "always-inject-tag", "never-inject-tag"]
  },
  "removed": [
    "candidate-pool",
    "review-queue",
    "runtime-state",
    "promotion",
    "confidence",
    "rollback-history",
    "vector-memory",
    "lifecycle",
    "governance",
    "retrieval-audit"
  ]
}
